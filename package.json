{
  "name": "dsh-credit-float",
  "version": "0.3.0",
  "private": true,
  "description": "把各渠道（LobsterAI / WorkBuddy / CodeArts / Qoder / Trae / Cline / MiniMax / ZCode …）的剩余积分显示在桌面置顶胶囊里，完全脱离 DSH 窗口（页面内不再显示）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "license": "MIT"
}
