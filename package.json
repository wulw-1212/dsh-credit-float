{
  "name": "dsh-credit-float",
  "version": "0.3.7",
  "private": true,
  "description": "完全脱离 DSH 窗口（页面内不再显示）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
"repository": {
    "type": "git",
    "url": "https://github.com/wulw-1212/dsh-credit-float.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "license": "MIT"
}
